APP_URL=http://localhost:3000

# --- SMTP Config (optional) ---
ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- 42 OAuth ---
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

# --- Google OAuth ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://www.siraj.club/api/auth/callback/google
# Scopes: openid email profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Play app (live games) ---
# Base URL of the play app; the base app POSTs to `${PLAY_APP_URL}/api/games`.
# Local dev uses the built-in mock (disabled in production):
#   PLAY_APP_URL=http://localhost:3000/api/dev/mock-play
# Shared HMAC secret (min 32 chars), same value in both apps:
#   openssl rand -hex 32
PLAY_APP_URL=http://localhost:3000/api/dev/mock-play
PLAY_APP_SHARED_SECRET=

# --- Supabase Config ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
